# direnv + devenv + nix-direnv
# Requires: nix (flakes enabled), direnv, nix-direnv >= 3.0.5
# Usage: `direnv allow` in repo root. This file is the canonical entrypoint —
# copy it verbatim to new repos.

if ! has nix_direnv_version || ! nix_direnv_version 3.0.6; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.6/direnvrc" "sha256-RYcUJaRMf8oF5LznXzA8cPmZ+G3tEQu5g-cXvhF/XS8="
fi

# watch devenv files so direnv reloads on change
watch_file devenv.nix
watch_file devenv.yaml
watch_file devenv.lock
watch_file flake.nix
watch_file flake.lock

# use devenv shell (falls back to nix develop if devenv not installed)
if has devenv; then
  use devenv
else
  if ! use flake . --impure; then
    echo "devenv not found and 'nix develop' failed. Install devenv: https://devenv.sh/getting-started/" >&2
  fi
fi

# optional: load .env.local if present (gitignored)
dotenv_if_exists .env.local
